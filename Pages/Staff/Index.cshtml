@page
@model rz.Pages.Staff.IndexModel
@{
    ViewData["Title"] = "Staff Directory";
}

<h1>Staff Directory</h1>
<p>Total Active Employees: @Model.ActiveCount</p>

<!-- Flash Success Notification -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.5rem;">
        <span style="font-size: 1.25rem;">✅</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Add New Staff Button -->
<div style="margin-bottom: 1.25rem;">
    <a asp-page="/Staff/Create" class="btn btn-primary">+ Add New Staff Member</a>
</div>
    <!-- Search Form using HTTP GET -->
    <form method="get" class="search-form">
        <div class="search-group">
            <input type="text" asp-for="SearchTerm" placeholder="Search by last name..." class="search-input" />
            <button type="submit" class="btn btn-primary">Search</button>

            <!-- Render Clear button only when a filter is currently active -->
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-page="/Staff/Index" class="btn btn-secondary">Clear</a>
            }
        </div>
    </form>

 <!-- Display message when search returns no matching records -->
    @if (!Model.StaffMembers.Any())
    {
        <div class="no-results">
            <p>No staff members found matching "<strong>@Model.SearchTerm</strong>".</p>
        </div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>


    @foreach (var member in Model.StaffMembers)
    {
        <tr>
            <td>@member.StaffId</td>
            <td>@member.FirstName @member.LastName</td>
        
<td>
    <a asp-page="/Staff/Details" asp-route-id="@member.StaffId" class="btn btn-outline btn-sm">Details</a>
    <a asp-page="/Staff/Edit" asp-route-id="@member.StaffId" class="btn btn-outline btn-sm">Edit</a>
    <a asp-page="/Staff/Delete" asp-route-id="@member.StaffId" class="btn btn-outline btn-sm" style="color: var(--danger);">Delete</a>
</td>
        </tr>
    }

          
            </tbody>
        </table>
    }